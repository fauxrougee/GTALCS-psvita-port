diff --git a/src/gl/gl3render.cpp b/src/gl/gl3render.cpp
index a02c5c0..9c7242e 100644
--- a/src/gl/gl3render.cpp
+++ b/src/gl/gl3render.cpp
@@ -24,6 +24,19 @@ void
 drawInst_simple(InstanceDataHeader *header, InstanceData *inst)
 {
 	flushCache();
+#ifdef PSP2
+	// Mesh instancing already computes the exact index range. Supply it to
+	// vitaGL instead of letting the driver scan the indices again per draw.
+	// Keep a fallback for empty meshes, unavailable entry points or bad bounds.
+	if(glDrawRangeElements && inst->numVertices > 0){
+		uint32 end = inst->minVert + inst->numVertices - 1;
+		if(end < header->totalNumVertex && end <= 0xFFFF){
+			glDrawRangeElements(header->primType, inst->minVert, end,
+			                   inst->numIndex, GL_UNSIGNED_SHORT, (void*)(uintptr)inst->offset);
+			return;
+		}
+	}
+#endif
 	glDrawElements(header->primType, inst->numIndex,
 	               GL_UNSIGNED_SHORT, (void*)(uintptr)inst->offset);
 }
@@ -71,23 +84,57 @@ drawInst(InstanceDataHeader *header, InstanceData *inst)
 }
 
 
+#if defined(PSP2) && !defined(RW_GL_USE_VAOS)
+// All Vita layouts go through setAttribPointers, including Im2D/Im3D and skin.
+// Keep arrays enabled between draws; disable missing attributes BEFORE the next
+// draw so their constant defaults still work. Pointers are always refreshed:
+// a streamed or reallocated VBO can change storage without changing its name.
+static uint32 enabledAttribMask;
+
+void
+resetVertexInputState(void)
+{
+	for(uint32 index = 0; index < 32; index++)
+		if(enabledAttribMask & (1u << index))
+			glDisableVertexAttribArray(index);
+	enabledAttribMask = 0;
+}
+#endif
+
 void
 setAttribPointers(AttribDesc *attribDescs, int32 numAttribs)
 {
 	AttribDesc *a;
+#if defined(PSP2) && !defined(RW_GL_USE_VAOS)
+	uint32 desired = 0;
+	for(a = attribDescs; a != &attribDescs[numAttribs]; a++)
+		desired |= 1u << a->index;
+	uint32 removed = enabledAttribMask & ~desired;
+	for(uint32 index = 0; removed; index++, removed >>= 1)
+		if(removed & 1u)
+			glDisableVertexAttribArray(index);
+#endif
 	for(a = attribDescs; a != &attribDescs[numAttribs]; a++){
+#if defined(PSP2) && !defined(RW_GL_USE_VAOS)
+		if(!(enabledAttribMask & (1u << a->index)))
+#endif
 		glEnableVertexAttribArray(a->index);
 		glVertexAttribPointer(a->index, a->size, a->type, a->normalized,
 		                      a->stride, (void*)(uint64)a->offset);
 	}
+#if defined(PSP2) && !defined(RW_GL_USE_VAOS)
+	enabledAttribMask = desired;
+#endif
 }
 
 void
 disableAttribPointers(AttribDesc *attribDescs, int32 numAttribs)
 {
+#if !defined(PSP2) || defined(RW_GL_USE_VAOS)
 	AttribDesc *a;
 	for(a = attribDescs; a != &attribDescs[numAttribs]; a++)
 		glDisableVertexAttribArray(a->index);
+#endif
 }
 
