+++ b/src/gl/gl3immed.cpp
@@ -30,6 +30,22 @@ static int32 u_xform;
 #define STARTINDICES 10000
 #define STARTVERTICES 10000
 
+// Streams `size` bytes of immediate geometry into the bound buffer, whose
+// normal size is `bufSize`.
+static void
+uploadStreamData(GLenum target, uint32 bufSize, const void *data, uint32 size)
+{
+#ifdef PSP2
+	// vitaGL allocates a new store on every glBufferData and frees the old one
+	// ~3 frames later, so orphaning the full buffer on each immediate draw ran
+	// it out of memory (then it sleeps 1s per allocation). Upload what's drawn.
+	glBufferData(target, size, data, GL_STREAM_DRAW);
+#else
+	glBufferData(target, bufSize, nil, GL_STREAM_DRAW);
+	glBufferSubData(target, 0, size, data);
+#endif
+}
+
 static Shader *im2dShader;
 static AttribDesc im2dattribDesc[3] = {
 	{ ATTRIB_POS,        GL_FLOAT,         GL_FALSE, 4,
