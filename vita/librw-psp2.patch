+// Streams `size` bytes of immediate geometry into the bound buffer, whose
+// normal size is `bufSize`.
+static void
+uploadStreamData(GLenum target, uint32 bufSize, const void *data, uint32 size)
+{
+#ifdef PSP2
+	// vitaGL allocates a new store on every glBufferData and frees the old one
+	// ~3 frames later, so orphaning the full buffer on each immediate draw ran
